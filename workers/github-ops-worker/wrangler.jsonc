{
  "name": "github-ops-worker",
  "main": "github-ops-worker.js",
  "compatibility_date": "2025-09-23",
  // Comma-separated allowlist entries:
  // - owner/repo (exact)
  // - owner/* (all repos for one owner)
  // - * (all repos reachable by the token)
  "vars": {
    "ALLOWED_REPOS": "solmasta/*"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
